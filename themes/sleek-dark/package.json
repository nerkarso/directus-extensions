{
  "name": "directus-extension-sleek-dark-theme",
  "description": "Sleek dark theme for Directus",
  "icon": "extension",
  "version": "0.1.6",
  "keywords": [
    "directus",
    "directus-extension",
    "directus-extension-theme"
  ],
